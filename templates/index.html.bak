<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoPhone</title>
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Apple System Fonts */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Hide Scrollbar */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Typography */
        .prose {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #1d1d1f;
            max-width: none;
        }
        .prose p { margin: 0.5em 0; }
        .prose strong { font-weight: 600; color: #1d1d1f; }
        .prose ul { margin: 0.5em 0; padding-left: 1.5em; list-style-type: disc; }
        .prose ol { margin: 0.5em 0; padding-left: 1.5em; list-style-type: decimal; }
        
        /* Tables */
        .prose table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            margin: 1em 0;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
            font-size: 0.9rem;
        }
        .prose thead { background-color: #f9fafb; border-bottom: 1px solid #e5e7eb; }
        .prose th { padding: 12px 16px; text-align: left; font-weight: 600; color: #6b7280; }
        .prose td { padding: 12px 16px; border-top: 1px solid #f3f4f6; color: #374151; }
        
        /* Pulse Animation */
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.5; }
            100% { transform: scale(2); opacity: 0; }
        }
        .status-dot-ring::before {
            content: '';
            position: absolute;
            left: 0; top: 0;
            width: 100%; height: 100%;
            background-color: inherit;
            border-radius: 50%;
            z-index: -1;
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }

        /* Input Glow */
        .input-glow:focus-within {
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1), 0 8px 20px rgba(0, 0, 0, 0.05);
        }
        
        /* Animations */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up { animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-fade-in { animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
</head>
<body class="bg-[#F5F5F7] h-screen flex flex-col overflow-hidden">
    
    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200/50 h-16 transition-all duration-300">
        <div class="max-w-7xl mx-auto h-full px-6 flex items-center justify-between">
            <div class="flex items-center space-x-3 group cursor-default">
                <div class="w-8 h-8 rounded-xl bg-black text-white flex items-center justify-center shadow-lg transform group-hover:scale-105 transition-transform duration-300">
                    <i data-lucide="smartphone" class="w-4 h-4"></i>
                </div>
                <h1 class="text-lg font-semibold tracking-tight text-gray-900">AutoPhone</h1>
            </div>
            
            <div id="status-indicator" class="flex items-center px-3 py-1.5 rounded-full bg-gray-100/50 border border-gray-200/50 backdrop-blur-sm transition-colors duration-300">
                <div class="relative w-2 h-2 mr-2">
                    <div class="w-2 h-2 bg-red-500 rounded-full relative z-10 transition-colors duration-300"></div>
                    <div class="status-dot-ring absolute inset-0 bg-red-500 rounded-full"></div>
                </div>
                <span class="text-xs font-medium text-gray-500 transition-colors duration-300">Not Connected</span>
            </div>
        </div>
    </header>

    <!-- Main Layout -->
    <div class="flex h-full pt-16">
        
        <!-- Chat Area -->
        <main id="chat-container" class="flex-1 overflow-y-auto pb-32 px-4 scroll-smooth no-scrollbar relative">
            <div class="max-w-3xl mx-auto space-y-8 pt-8">
                <!-- Welcome Card -->
                <div id="welcome-card" class="flex flex-col items-center justify-center py-12 space-y-6 text-center animate-fade-in-up">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white flex items-center justify-center shadow-xl mb-4">
                        <i data-lucide="sparkles" class="w-8 h-8"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-[#1d1d1f] tracking-tight">有什么我可以帮您的吗？</h2>
                    <p class="text-[#86868b] max-w-md text-base leading-relaxed">
                        我是您的智能手机任务编排专家。您可以让我帮您跨应用比价、查找生活信息、或者规划行程。
                    </p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 w-full max-w-2xl mt-8">
                        <button onclick="fillInput('帮我在京东淘宝拼多多比价，找最便宜的iPhone 16 Pro')" class="p-4 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-100 hover:-translate-y-0.5 transition-all duration-300 text-left group">
                            <span class="text-sm font-medium text-gray-900 group-hover:text-blue-600 transition-colors">全网比价 iPhone 16 Pro</span>
                            <p class="text-xs text-gray-500 mt-1">京东、淘宝、拼多多自动比价</p>
                        </button>
                        <button onclick="fillInput('在小红书找一家好吃的火锅店，然后去大众点评看评分')" class="p-4 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-100 hover:-translate-y-0.5 transition-all duration-300 text-left group">
                            <span class="text-sm font-medium text-gray-900 group-hover:text-blue-600 transition-colors">跨应用查找美食</span>
                            <p class="text-xs text-gray-500 mt-1">小红书种草 -> 大众点评拔草</p>
                        </button>
                    </div>
                </div>
                <!-- Messages will be injected here -->
            </div>
        </main>

        <!-- Mission Control Panel (Right Sidebar) -->
        <aside id="mission-control" class="w-80 bg-white/80 backdrop-blur-xl border-l border-gray-200/50 hidden lg:flex flex-col transform transition-transform duration-500 z-40">
            <div class="p-4 border-b border-gray-100/50 flex items-center justify-between bg-white/50">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 flex items-center">
                    <i data-lucide="layout-dashboard" class="w-3.5 h-3.5 mr-1.5"></i>
                    Mission Control
                </h3>
                <div id="status-badge" class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 text-[10px] font-medium transition-colors">
                    Idle
                </div>
            </div>
            
            <div class="flex-1 overflow-y-auto p-4 space-y-6 no-scrollbar">
                
                <!-- Active Tool -->
                <div id="active-tool-card" class="hidden animate-fade-in">
                    <div class="text-xs font-medium text-gray-400 mb-2 uppercase tracking-wide">Current Action</div>
                    <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-xl p-4 text-white shadow-lg relative overflow-hidden group">
                        <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="relative z-10">
                            <div class="flex items-center space-x-2 mb-2">
                                <span class="relative flex h-2 w-2">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                  <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                                </span>
                                <div id="tool-name" class="text-xs font-bold uppercase tracking-wider text-blue-200">Checking...</div>
                            </div>
                            <div id="tool-args" class="text-sm font-mono text-gray-300 break-words leading-snug opacity-90"></div>
                        </div>
                    </div>
                </div>

                <!-- Planning / Thoughts -->
                <div class="flex flex-col h-1/3 min-h-[150px]">
                    <div class="text-xs font-medium text-gray-400 mb-2 uppercase tracking-wide flex items-center">
                        <i data-lucide="brain-circuit" class="w-3.5 h-3.5 mr-1.5"></i>
                        Live Thought Process
                    </div>
                    <div id="thought-process" class="flex-1 bg-gray-50/50 rounded-xl p-3 border border-gray-100 text-xs text-gray-600 font-mono leading-relaxed overflow-y-auto no-scrollbar whitespace-pre-wrap">Waiting for task...</div>
                </div>

                <!-- History -->
                <div>
                    <div class="text-xs font-medium text-gray-400 mb-2 uppercase tracking-wide flex items-center">
                        <i data-lucide="history" class="w-3.5 h-3.5 mr-1.5"></i>
                        Action History
                    </div>
                    <div id="action-history" class="space-y-2">
                        <div class="text-xs text-gray-400 italic text-center py-4">No actions yet</div>
                    </div>
                </div>

            </div>
        </aside>

    </div>

    <!-- Input Area -->
    <div class="fixed bottom-0 left-0 right-0 lg:right-80 p-6 z-40 bg-gradient-to-t from-[#F5F5F7] via-[#F5F5F7]/95 to-transparent pt-12 pointer-events-none">
        <div class="max-w-3xl mx-auto pointer-events-auto">
            <div class="relative group input-glow bg-white rounded-[24px] shadow-lg border border-gray-200/60 transition-all duration-300">
                <textarea 
                    id="user-input" 
                    rows="1"
                    class="w-full bg-transparent text-[#1d1d1f] placeholder-gray-400 px-6 py-4 pr-16 rounded-[24px] focus:outline-none resize-none max-h-32 overflow-y-auto leading-relaxed"
                    placeholder="描述您的任务..."
                    oninput="autoResize(this)"
                    onkeypress="handleKeyPress(event)"></textarea>
                
                <div class="absolute right-2 bottom-2">
                    <button onclick="sendMessage()" 
                        id="send-btn"
                        class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center disabled:opacity-30 disabled:cursor-not-allowed hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
                        <i data-lucide="arrow-up" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
            <p class="text-center text-[10px] text-gray-400 mt-3 font-medium tracking-wide">由 AutoGLM & Agno 提供强力驱动</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        lucide.createIcons();
        
        let socket = null;
        let isConnecting = false;
        const chatContainer = document.getElementById('chat-container');
        const listContainer = chatContainer.firstElementChild; 
        const userInput = document.getElementById('user-input');
        const sendBtn = document.getElementById('send-btn');
        const statusIndicator = document.getElementById('status-indicator');
        const welcomeCard = document.getElementById('welcome-card');
        
        // Mission Control Elements
        const missionControl = document.getElementById('mission-control');
        const statusBadge = document.getElementById('status-badge');
        const activeToolCard = document.getElementById('active-tool-card');
        const toolNameEl = document.getElementById('tool-name');
        const toolArgsEl = document.getElementById('tool-args');
        const thoughtProcessEl = document.getElementById('thought-process');
        const actionHistoryEl = document.getElementById('action-history');

        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = Math.min(textarea.scrollHeight, 128) + 'px';
        }

        function fillInput(text) {
            userInput.value = text;
            autoResize(userInput);
            userInput.focus();
        }

        function connect() {
            if (isConnecting) return;
            isConnecting = true;
            
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            socket = new WebSocket(`${protocol}//${window.location.host}/ws`);

            socket.onopen = () => {
                isConnecting = false;
                updateStatus(true);
            };

            socket.onclose = () => {
                isConnecting = false;
                updateStatus(false);
                setTimeout(connect, 3000);
            };

            socket.onmessage = (event) => {
                const data = JSON.parse(event.data);
                handleMessage(data);
            };
        }

        function updateStatus(connected) {
            const dot = statusIndicator.querySelector('.bg-red-500, .bg-green-500');
            const ring = statusIndicator.querySelector('.status-dot-ring');
            const text = statusIndicator.querySelector('span');
            
            if (connected) {
                dot.className = 'w-2 h-2 bg-green-500 rounded-full relative z-10 transition-colors duration-300';
                ring.className = 'status-dot-ring absolute inset-0 bg-green-500 rounded-full opacity-30';
                text.textContent = '已连接';
                text.className = 'text-xs font-medium text-green-600 transition-colors duration-300';
                sendBtn.disabled = false;
            } else {
                dot.className = 'w-2 h-2 bg-red-500 rounded-full relative z-10 transition-colors duration-300';
                ring.className = 'status-dot-ring absolute inset-0 bg-red-500 rounded-full opacity-30';
                text.textContent = '未连接';
                text.className = 'text-xs font-medium text-gray-500 transition-colors duration-300';
                sendBtn.disabled = true;
            }
        }

        function appendMessage(role, content, isHtml = false) {
            if (welcomeCard) welcomeCard.style.display = 'none';

            const div = document.createElement('div');
            div.className = 'flex items-start mb-6 animate-fade-in ' + (role === 'user' ? 'justify-end' : '');
            
            const bubbleClass = role === 'user' 
                ? 'bg-[#007AFF] text-white rounded-[20px] rounded-tr-[4px] px-5 py-3 shadow-sm max-w-[85%]' 
                : 'bg-white text-[#1d1d1f] rounded-[20px] rounded-tl-[4px] px-6 py-5 shadow-sm border border-gray-100 max-w-[90%] prose prose-blue';

            let innerContent = isHtml ? content : content;

            if (role === 'assistant' && !isHtml) {
                innerContent = marked.parse(content);
            }

            div.innerHTML = `
                <div class="${bubbleClass} leading-relaxed break-words text-[15px]">
                    ${innerContent}
                </div>
            `;

            listContainer.appendChild(div);
            if (role === 'assistant') lucide.createIcons();
            scrollToBottom();
            return div;
        }

        let currentAssistantMessageDiv = null;
        let currentAssistantContent = "";

        // --- Mission Control Logic ---

        function updateAgentStatus(status, type = 'default') {
            statusBadge.textContent = status;
            if (type === 'thinking') {
                statusBadge.className = 'px-2 py-0.5 rounded-full bg-blue-100 text-blue-600 text-[10px] font-medium transition-colors animate-pulse';
            } else if (type === 'executing') {
                statusBadge.className = 'px-2 py-0.5 rounded-full bg-purple-100 text-purple-600 text-[10px] font-medium transition-colors animate-pulse';
            } else if (type === 'error') {
                statusBadge.className = 'px-2 py-0.5 rounded-full bg-red-100 text-red-600 text-[10px] font-medium transition-colors';
            } else {
                statusBadge.className = 'px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 text-[10px] font-medium transition-colors';
            }
        }

        function addToHistory(name, args) {
            // Remove placeholder
            const placeholder = actionHistoryEl.querySelector('.italic');
            if (placeholder) placeholder.remove();
            
            const item = document.createElement('div');
            item.className = 'bg-gray-50 border border-gray-100 rounded-lg p-2.5 flex items-center space-x-3 animate-fade-in hover:bg-white transition-colors cursor-default';
            item.innerHTML = `
                <div class="w-6 h-6 rounded bg-white border border-gray-100 flex items-center justify-center flex-shrink-0 shadow-sm">
                    <i data-lucide="check" class="w-3 h-3 text-green-500"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-[10px] uppercase font-bold text-gray-400 tracking-wider mb-0.5">${name}</div>
                    <div class="text-xs text-gray-700 truncate font-mono">${args}</div>
                </div>
            `;
            // Insert at top
            actionHistoryEl.insertBefore(item, actionHistoryEl.firstChild);
            lucide.createIcons();
        }

        function handleMessage(data) {
            if (data.type === 'chunk') {
                updateAgentStatus("Thinking...", "thinking");
                
                if (!currentAssistantMessageDiv) {
                    currentAssistantMessageDiv = appendMessage('assistant', '', true);
                }
                currentAssistantContent += data.content;
                const contentDiv = currentAssistantMessageDiv.querySelector('.leading-relaxed');
                contentDiv.innerHTML = marked.parse(currentAssistantContent);
                
                // Update thought process in real-time
                thoughtProcessEl.textContent = currentAssistantContent;
                thoughtProcessEl.scrollTop = thoughtProcessEl.scrollHeight;
                
                scrollToBottom();

            } else if (data.type === 'tool_start') {
                updateAgentStatus("Executing Action", "executing");
                
                // Show Active Tool
                activeToolCard.classList.remove('hidden');
                toolNameEl.textContent = data.tool_name;
                
                let argsStr = "";
                if (data.tool_args) {
                    if (typeof data.tool_args === 'object') {
                         if (data.tool_args.task_description) {
                             argsStr = data.tool_args.task_description;
                         } else {
                             argsStr = JSON.stringify(data.tool_args, null, 2);
                         }
                    } else {
                        argsStr = String(data.tool_args);
                    }
                }
                // Limit args string length for display
                const displayArgs = argsStr.length > 100 ? argsStr.substring(0, 100) + "..." : argsStr;
                toolArgsEl.textContent = displayArgs;
                
                // Add to History immediately
                addToHistory(data.tool_name, displayArgs);

                // Add inline indicator in chat
                if (!currentAssistantMessageDiv) {
                    currentAssistantMessageDiv = appendMessage('assistant', '', true);
                }
                const contentDiv = currentAssistantMessageDiv.querySelector('.leading-relaxed');
                const toolHtml = `
                    <div class="flex items-center space-x-3 text-sm text-gray-600 bg-gray-50/80 backdrop-blur-sm rounded-xl p-3 my-3 border border-gray-100 select-none shadow-sm">
                        <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center border border-gray-100 shadow-sm">
                            <i data-lucide="terminal" class="w-4 h-4 text-purple-500"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-0.5">Action</div>
                            <div class="truncate font-medium text-gray-900">${displayArgs || data.tool_name}</div>
                        </div>
                    </div>
                `;
                contentDiv.insertAdjacentHTML('beforeend', toolHtml);
                lucide.createIcons();
                scrollToBottom();
                
            } else if (data.type === 'end') {
                updateAgentStatus("Idle", "default");
                activeToolCard.classList.add('hidden');
                currentAssistantMessageDiv = null;
                currentAssistantContent = "";
            } else if (data.type === 'error') {
                updateAgentStatus("Error", "error");
                appendMessage('system', `<div class="text-red-500 bg-red-50 p-3 rounded-lg border border-red-100 flex items-center"><i data-lucide="alert-circle" class="w-4 h-4 mr-2"></i>${data.content}</div>`, true);
                lucide.createIcons();
            }
        }

        function sendMessage() {
            const text = userInput.value.trim();
            if (!text || !socket || socket.readyState !== WebSocket.OPEN) return;

            appendMessage('user', text);
            socket.send(JSON.stringify({ type: 'message', content: text }));
            
            userInput.value = '';
            userInput.style.height = 'auto'; 
            
            currentAssistantContent = "";
            currentAssistantMessageDiv = null;
            
            // Reset Mission Control for new turn
            updateAgentStatus("Starting...", "default");
            thoughtProcessEl.textContent = "Analyzing request...";
            // We keep history visible for context
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        }

        function scrollToBottom() {
            const lastChild = listContainer.lastElementChild;
            if(lastChild) {
                lastChild.scrollIntoView({ behavior: 'smooth', block: 'end' });
            }
        }

        connect();
    </script>
</body>
</html>