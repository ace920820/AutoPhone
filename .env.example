# ===========================================
# Phone Agent 环境变量配置模板
# 复制此文件为 .env 并修改配置
# ===========================================

# 模型 API 基础 URL（不包含 /chat/completions）
PHONE_AGENT_BASE_URL=https://fapiao.jajkmh.com/agents/v2

# 模型名称
PHONE_AGENT_MODEL=wonders/Qwen3-VL-8B

# API 密钥（如果不需要可以设为 EMPTY）
PHONE_AGENT_API_KEY=EMPTY

# 单次任务最大步数
PHONE_AGENT_MAX_STEPS=100

# ADB 设备 ID（留空则自动检测）
PHONE_AGENT_DEVICE_ID=

# 语言设置 (cn 或 en)
PHONE_AGENT_LANG=cn
